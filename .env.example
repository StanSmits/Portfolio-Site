# Contact form (server-side only — never prefix these with VITE_)
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Portfolio <portfolio@stansmits.nl>"
CONTACT_FROM_EMAIL=
# Where messages are delivered (defaults to connect@stansmits.nl)
CONTACT_TO_EMAIL=connect@stansmits.nl
# Optional extra origins allowed to post, comma-separated (e.g. preview deployments)
CONTACT_ALLOWED_ORIGINS=
# Local development only: validate submissions without sending email
CONTACT_DRY_RUN=0
